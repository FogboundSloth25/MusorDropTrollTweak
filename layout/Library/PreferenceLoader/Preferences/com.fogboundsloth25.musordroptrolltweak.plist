<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>title</key>
    <string>MusorDropTrollTweak</string>
    <key>entry</key>
    <dict>
        <key>cell</key>
        <string>PSLinkCell</string>
        <key>label</key>
        <string>MusorDropTrollTweak</string>
    </dict>
    <key>items</key>
    <array>
        <dict>
            <key>cell</key>
            <string>PSGroupCell</string>
            <key>label</key>
            <string>Основное</string>
            <key>footerText</key>
            <string>Твик запускает встроенное видео поверх открытого стороннего приложения. Выключите «Включено», чтобы отключить автоматический запуск.</string>
        </dict>
        <dict>
            <key>cell</key>
            <string>PSSwitchCell</string>
            <key>label</key>
            <string>Включено</string>
            <key>key</key>
            <string>enabled</string>
            <key>default</key>
            <true/>
            <key>defaults</key>
            <string>com.fogboundsloth25.musordroptrolltweak</string>
            <key>PostNotification</key>
            <string>com.fogboundsloth25.musordroptrolltweak/preferences.changed</string>
        </dict>
        <dict>
            <key>cell</key>
            <string>PSGroupCell</string>
            <key>label</key>
            <string>Задержка показа</string>
            <key>footerText</key>
            <string>Сколько секунд ждать после того, как приложение стало активным. При изменении задержки текущий таймер отменяется и новый отсчёт начинается сразу.</string>
        </dict>
        <dict>
            <key>cell</key>
            <string>PSSliderCell</string>
            <key>key</key>
            <string>delay</string>
            <key>default</key>
            <real>10.0</real>
            <key>min</key>
            <real>0.0</real>
            <key>max</key>
            <real>60.0</real>
            <key>showValue</key>
            <true/>
            <key>isSegmented</key>
            <true/>
            <key>segmentCount</key>
            <integer>60</integer>
            <key>defaults</key>
            <string>com.fogboundsloth25.musordroptrolltweak</string>
            <key>PostNotification</key>
            <string>com.fogboundsloth25.musordroptrolltweak/preferences.changed</string>
        </dict>
        <dict>
            <key>cell</key>
            <string>PSGroupCell</string>
            <key>label</key>
            <string>Громкость</string>
            <key>footerText</key>
            <string>Громкость встроенной аудиодорожки: 0% — без звука, 100% — полная громкость.</string>
        </dict>
        <dict>
            <key>cell</key>
            <string>PSSliderCell</string>
            <key>key</key>
            <string>volume</string>
            <key>default</key>
            <real>100.0</real>
            <key>min</key>
            <real>0.0</real>
            <key>max</key>
            <real>100.0</real>
            <key>showValue</key>
            <true/>
            <key>isSegmented</key>
            <true/>
            <key>segmentCount</key>
            <integer>100</integer>
            <key>defaults</key>
            <string>com.fogboundsloth25.musordroptrolltweak</string>
            <key>PostNotification</key>
            <string>com.fogboundsloth25.musordroptrolltweak/preferences.changed</string>
        </dict>
        <dict>
            <key>cell</key>
            <string>PSGroupCell</string>
            <key>label</key>
            <string>Кастомное видео</string>
            <key>footerText</key>
            <string>Пустое поле = встроенное видео с удалённым зелёным фоном. Для своего видео укажите полный путь к MP4 или MOV. Кастомный файл не изменяется.</string>
        </dict>
        <dict>
            <key>cell</key>
            <string>PSEditTextCell</string>
            <key>label</key>
            <string>Путь к видео</string>
            <key>key</key>
            <string>videoPath</string>
            <key>default</key>
            <string></string>
            <key>placeholder</key>
            <string>/путь/к/видео.mov</string>
            <key>defaults</key>
            <string>com.fogboundsloth25.musordroptrolltweak</string>
            <key>PostNotification</key>
            <string>com.fogboundsloth25.musordroptrolltweak/preferences.changed</string>
        </dict>
    </array>
</dict>
</plist>

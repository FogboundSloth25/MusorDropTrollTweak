<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>title</key>
    <string>MusorDropTrollTweak</string>
    <key>entry</key>
    <dict>
        <key>cell</key>
        <string>PSLinkCell</string>
        <key>label</key>
        <string>MusorDropTrollTweak</string>
    </dict>
    <key>items</key>
    <array>
        <dict>
            <key>cell</key>
            <string>PSGroupCell</string>
            <key>label</key>
            <string>Основное</string>
            <key>footerText</key>
            <string>Твик запускает видео поверх открытого стороннего приложения. Выключите «Включено», чтобы полностью отключить эффект.</string>
        </dict>
        <dict>
            <key>cell</key>
            <string>PSSwitchCell</string>
            <key>label</key>
            <string>Включено</string>
            <key>key</key>
            <string>enabled</string>
            <key>default</key>
            <true/>
            <key>defaults</key>
            <string>com.fogboundsloth25.musordroptrolltweak</string>
            <key>PostNotification</key>
            <string>com.fogboundsloth25.musordroptrolltweak/preferences.changed</string>
        </dict>
        <dict>
            <key>cell</key>
            <string>PSGroupCell</string>
            <key>label</key>
            <string>Задержка</string>
            <key>footerText</key>
            <string>Сколько секунд ждать после запуска/возврата приложения до показа видео. При изменении значения текущий отсчёт сбрасывается и начинается заново.</string>
        </dict>
        <dict>
            <key>cell</key>
            <string>PSSliderCell</string>
            <key>label</key>
            <string>Секунды</string>
            <key>key</key>
            <string>delay</string>
            <key>default</key>
            <real>10.0</real>
            <key>min</key>
            <real>0.0</real>
            <key>max</key>
            <real>60.0</real>
            <key>showValue</key>
            <true/>
            <key>isSegmented</key>
            <true/>
            <key>segmentCount</key>
            <integer>60</integer>
            <key>defaults</key>
            <string>com.fogboundsloth25.musordroptrolltweak</string>
            <key>PostNotification</key>
            <string>com.fogboundsloth25.musordroptrolltweak/preferences.changed</string>
        </dict>
        <dict>
            <key>cell</key>
            <string>PSGroupCell</string>
            <key>label</key>
            <string>Звук</string>
            <key>footerText</key>
            <string>Громкость аудиодорожки видео: 0% — без звука, 100% — исходная громкость.</string>
        </dict>
        <dict>
            <key>cell</key>
            <string>PSSliderCell</string>
            <key>label</key>
            <string>Громкость (%)</string>
            <key>key</key>
            <string>volume</string>
            <key>default</key>
            <real>1.0</real>
            <key>min</key>
            <real>0.0</real>
            <key>max</key>
            <real>1.0</real>
            <key>showValue</key>
            <true/>
            <key>isSegmented</key>
            <true/>
            <key>segmentCount</key>
            <integer>100</integer>
            <key>defaults</key>
            <string>com.fogboundsloth25.musordroptrolltweak</string>
            <key>PostNotification</key>
            <string>com.fogboundsloth25.musordroptrolltweak/preferences.changed</string>
        </dict>
        <dict>
            <key>cell</key>
            <string>PSGroupCell</string>
            <key>label</key>
            <string>Видео</string>
            <key>footerText</key>
            <string>Оставьте поле пустым, чтобы использовать встроенное видео с удалённым зелёным фоном. Для своего файла укажите полный путь к MP4 или MOV на устройстве; пользовательское видео не изменяется.</string>
        </dict>
        <dict>
            <key>cell</key>
            <string>PSEditTextCell</string>
            <key>label</key>
            <string>Кастомное видео</string>
            <key>key</key>
            <string>videoPath</string>
            <key>default</key>
            <string></string>
            <key>placeholder</key>
            <string>/путь/к/видео.mov</string>
            <key>defaults</key>
            <string>com.fogboundsloth25.musordroptrolltweak</string>
            <key>defaultsWrite</key>
            <true/>
            <key>PostNotification</key>
            <string>com.fogboundsloth25.musordroptrolltweak/preferences.changed</string>
        </dict>
    </array>
</dict>
</plist>

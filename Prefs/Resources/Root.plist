<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>title</key>
    <string>MusorDropTrollTweak</string>
    <key>items</key>
    <array>
        <dict>
            <key>cell</key>
            <string>PSGroupCell</string>
            <key>label</key>
            <string>Основное</string>
            <key>footerText</key>
            <string>После изменения параметров нажмите «Применить». До нажатия «Применить» уже работающий таймер и видео используют старые параметры.</string>
        </dict>
        <dict>
            <key>cell</key>
            <string>PSSwitchCell</string>
            <key>label</key>
            <string>Включено</string>
            <key>key</key>
            <string>enabled</string>
            <key>default</key>
            <true/>
            <key>defaults</key>
            <string>com.fogboundsloth25.musordroptrolltweak</string>
        </dict>
        <dict>
            <key>cell</key>
            <string>PSGroupCell</string>
            <key>label</key>
            <string>Задержка показа</string>
            <key>footerText</key>
            <string>Сколько секунд ждать после активации приложения. От 0 до 60 секунд. Изменение вступает в силу после «Применить».</string>
        </dict>
        <dict>
            <key>cell</key>
            <string>PSSliderCell</string>
            <key>label</key>
            <string>Задержка (сек.)</string>
            <key>key</key>
            <string>delay</string>
            <key>default</key>
            <real>10.0</real>
            <key>min</key>
            <real>0.0</real>
            <key>max</key>
            <real>60.0</real>
            <key>showValue</key>
            <true/>
            <key>isSegmented</key>
            <true/>
            <key>segmentCount</key>
            <integer>60</integer>
            <key>defaults</key>
            <string>com.fogboundsloth25.musordroptrolltweak</string>
        </dict>
        <dict>
            <key>cell</key>
            <string>PSGroupCell</string>
            <key>label</key>
            <string>Громкость</string>
            <key>footerText</key>
            <string>Громкость встроенного или выбранного видео: 0% — без звука, 100% — исходный уровень. Изменение вступает в силу после «Применить».</string>
        </dict>
        <dict>
            <key>cell</key>
            <string>PSSliderCell</string>
            <key>label</key>
            <string>Громкость (%)</string>
            <key>key</key>
            <string>volume</string>
            <key>default</key>
            <real>100.0</real>
            <key>min</key>
            <real>0.0</real>
            <key>max</key>
            <real>100.0</real>
            <key>showValue</key>
            <true/>
            <key>isSegmented</key>
            <true/>
            <key>segmentCount</key>
            <integer>100</integer>
            <key>defaults</key>
            <string>com.fogboundsloth25.musordroptrolltweak</string>
        </dict>
        <dict>
            <key>cell</key>
            <string>PSGroupCell</string>
            <key>label</key>
            <string>Видео</string>
            <key>footerText</key>
            <string>Пустое поле использует встроенное HEVC-видео с alpha. Для собственного MP4/MOV укажите полный путь. Кастомный файл не изменяется.</string>
        </dict>
        <dict>
            <key>cell</key>
            <string>PSEditTextCell</string>
            <key>label</key>
            <string>Путь к видео</string>
            <key>key</key>
            <string>videoPath</string>
            <key>default</key>
            <string></string>
            <key>placeholder</key>
            <string>/путь/к/видео.mov</string>
            <key>defaults</key>
            <string>com.fogboundsloth25.musordroptrolltweak</string>
        </dict>
        <dict>
            <key>cell</key>
            <string>PSButtonCell</string>
            <key>label</key>
            <string>Применить</string>
            <key>action</key>
            <string>applySettings</string>
        </dict>
    </array>
</dict>
</plist>

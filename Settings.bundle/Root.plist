<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>PreferenceSpecifiers</key>
    <array>
        <dict>
            <key>Type</key><string>PSGroupSpecifier</string>
            <key>Title</key><string>MusorDrop</string>
            <key>FooterText</key><string>Настройки развлекательного видео-розыгрыша.</string>
        </dict>
        <dict>
            <key>Type</key><string>PSSwitchSpecifier</string>
            <key>Title</key><string>Включено</string>
            <key>Key</key><string>enabled</string>
            <key>DefaultValue</key><true/>
        </dict>
        <dict>
            <key>Type</key><string>PSTextFieldSpecifier</string>
            <key>Title</key><string>Задержка</string>
            <key>Key</key><string>delay</string>
            <key>DefaultValue</key><real>10.0</real>
            <key>KeyboardType</key><integer>4</integer>
            <key>IsSecure</key><false/>
            <key>Placeholder</key><string>Секунды</string>
        </dict>
        <dict>
            <key>Type</key><string>PSSwitchSpecifier</string>
            <key>Title</key><string>Отключить звук</string>
            <key>Key</key><string>muted</string>
            <key>DefaultValue</key><false/>
        </dict>
        <dict>
            <key>Type</key><string>PSTextFieldSpecifier</string>
            <key>Title</key><string>Путь к видео</string>
            <key>Key</key><string>videoPath</string>
            <key>DefaultValue</key><string></string>
            <key>AutocapitalizationType</key><integer>0</integer>
            <key>AutocorrectionType</key><integer>1</integer>
            <key>Placeholder</key><string>Полный путь к MP4/MOV</string>
        </dict>
    </array>
    <key>StringsTable</key><string>Root</string>
</dict>
</plist>
